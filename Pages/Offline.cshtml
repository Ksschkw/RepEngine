@page
@model RepEngine.Pages.OfflineModel
@{
    ViewData["Title"] = "Offline";
}

<section class="container" style="padding: 6rem 0; text-center;">
    <div class="glass-card" style="max-width: 600px; margin: 0 auto;">
        <div style="font-size: 4rem; margin-bottom: 1rem;">📡</div>
        <h1>You're Offline</h1>
        <p style="font-size: 1.125rem; color: var(--text-secondary); margin-bottom: 2rem;">
            It looks like you've lost your internet connection. Don't worry, some features are still available!
        </p>

        <div class="glass-card" style="background: var(--bg-tertiary); padding: 1.5rem; margin-bottom: 2rem; text-align: left;">
            <h3 style="margin-bottom: 1rem;">What you can do offline:</h3>
            <ul style="color: var(--text-secondary); line-height: 2;">
                <li>✓ Browse cached pages</li>
                <li>✓ View your last known reputation score</li>
                <li>✓ Read documentation and help</li>
                <li>✗ Check live FairScore updates</li>
                <li>✗ Vote on proposals</li>
                <li>✗ Apply to jobs</li>
            </ul>
        </div>

        <button class="btn btn-primary btn-lg" onclick="window.location.reload()">
            🔄 Try Again
        </button>

        <p class="text-muted" style="margin-top: 1.5rem; font-size: 0.875rem;">
            Your connection will be restored automatically when you're back online.
        </p>
    </div>
</section>

<script>
// Auto-reload when back online
window.addEventListener('online', function() {
    console.log('Back online! Reloading...');
    setTimeout(() => {
        window.location.reload();
    }, 1000);
});

// Show online status
if (navigator.onLine) {
    document.querySelector('.glass-card').innerHTML += `
        <div style="margin-top: 2rem; padding: 1rem; background: var(--accent-success); color: white; border-radius: var(--radius-md);">
            ✓ You're back online! Click "Try Again" to continue.
        </div>
    `;
}
</script>
