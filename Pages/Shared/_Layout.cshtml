<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - RepEngine</title>
    <meta name="description" content="RepEngine — DAO governance with weighted voting and a reputation-gated freelance marketplace powered by FairScale." />

    <!-- PWA -->
    <link rel="manifest" href="~/manifest.json" />
    <meta name="theme-color" content="#0a0e1a" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="RepEngine" />

    <!-- Favicons -->
    <!-- Favicons -->
    <link rel="icon" type="image/png" href="~/icons/icon-192x192.png" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />

    <!-- Styles (single file) -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- ═══ DESKTOP NAV (hidden on mobile via CSS) ═══ -->
    <nav class="desktop-nav">
        <div class="dnav-inner">
            <a class="dnav-brand" asp-area="" asp-page="/Index">⚡ RepEngine</a>
            <div class="dnav-links">
                <a class="dnav-link" asp-area="" asp-page="/Index">Home</a>
                <a class="dnav-link" asp-area="" asp-page="/Dashboard">Dashboard</a>
                <a class="dnav-link" asp-area="" asp-page="/Governance">Governance</a>
                <a class="dnav-link" asp-area="" asp-page="/Marketplace">Gigs</a>
                <a class="dnav-link" asp-area="" asp-page="/PostJob">Post</a>
                <button id="walletConnectBtnDesktop" class="dnav-wallet">
                    <span id="walletBtnTextDesktop">Connect Wallet</span>
                </button>
            </div>
        </div>
    </nav>

    <!-- ═══ MOBILE TOP BAR (hidden on desktop via CSS) ═══ -->
    <header class="topbar">
        <div class="topbar-inner">
            <span class="topbar-brand">⚡ RepEngine</span>
            <button id="walletConnectBtn" class="topbar-wallet">
                <span id="walletBtnText">Connect</span>
            </button>
        </div>
    </header>

    <!-- ═══ PAGE CONTENT ═══ -->
    <main class="page-content">
        @RenderBody()
    </main>

    <!-- ═══ FOOTER ═══ -->
    <footer class="footer">
        <div class="container">
            <p>&copy; 2026 RepEngine &mdash; Powered by <a href="https://fairscale.xyz" target="_blank">FairScale</a></p>
        </div>
    </footer>

    <!-- ═══ MOBILE BOTTOM NAV (hidden on desktop via CSS) ═══ -->
    <nav class="bottom-nav" id="bottomNav">
        <a class="bnav-item" href="/" data-page="Home">
            <svg class="bnav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
            <span class="bnav-label">Home</span>
        </a>
        <a class="bnav-item" href="/Dashboard" data-page="Dashboard">
            <svg class="bnav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <rect x="3" y="3" width="7" height="7" rx="1"/>
                <rect x="14" y="3" width="7" height="7" rx="1"/>
                <rect x="3" y="14" width="7" height="7" rx="1"/>
                <rect x="14" y="14" width="7" height="7" rx="1"/>
            </svg>
            <span class="bnav-label">Dashboard</span>
        </a>
        <a class="bnav-item" href="/Governance" data-page="Governance">
            <svg class="bnav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                <path d="M2 17l10 5 10-5"/>
                <path d="M2 12l10 5 10-5"/>
            </svg>
            <span class="bnav-label">Govern</span>
        </a>
        <a class="bnav-item" href="/Marketplace" data-page="Marketplace">
            <svg class="bnav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <rect x="2" y="7" width="20" height="14" rx="2"/>
                <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
            </svg>
            <span class="bnav-label">Gigs</span>
        </a>
        <a class="bnav-item" href="/PostJob" data-page="PostJob">
            <svg class="bnav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path d="M12 5v14m7-7H5" stroke-width="2" stroke-linecap="round"/>
            </svg>
            <span class="bnav-label">Post</span>
        </a>
    </nav>

    <!-- ═══ WALLET MODAL ═══ -->
    <div id="walletModal" class="modal-overlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.75); z-index:9999; align-items:center; justify-content:center; backdrop-filter: blur(4px);">
        <div class="card fade-in" style="width: 90%; max-width: 380px; padding: 2.5rem 2rem;">
            <h3 class="mb-3 text-center">Connect Wallet</h3>
            <p class="text-sm text-muted text-center mb-5">
                Select your Solana wallet to authenticate.<br/><br/>
                <span style="font-size: 0.85em; opacity: 0.8;">If you don't have the extension installed, you will be redirected to get it. On mobile, this will open your wallet app.</span>
            </p>
            <div class="flex flex-col gap-3">
                <button class="btn btn-secondary btn-block flex items-center justify-center gap-2" style="background:#fc7422; color:white; border-color:#fc7422" onclick="connectWeb3Wallet('solflare')">
                    ☀️ Solflare
                </button>
                <button class="btn btn-secondary btn-block flex items-center justify-center gap-2" style="background:#551b8c; color:white; border-color:#551b8c" onclick="connectWeb3Wallet('phantom')">
                    👻 Phantom
                </button>
            </div>
            <button class="btn btn-ghost btn-block mt-4" onclick="closeWalletModal()">Cancel</button>
        </div>
    </div>

    <script src="~/js/pwa.js" asp-append-version="true"></script>
    <script src="~/js/ui.js" asp-append-version="true"></script>
    <script src="~/js/wallet.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
