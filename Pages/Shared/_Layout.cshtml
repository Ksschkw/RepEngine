<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - RepEngine</title>
    <meta name="description" content="RepEngine — DAO governance with weighted voting and a reputation-gated freelance marketplace powered by FairScale." />

    <!-- PWA -->
    <link rel="manifest" href="~/manifest.json" />
    <meta name="theme-color" content="#0a0e1a" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="RepEngine" />

    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="icon" type="image/png" sizes="192x192" href="~/icons/icon-192x192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/icons/icon-192x192.png" />

    <!-- Styles (single file) -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- ═══ DESKTOP NAV (hidden on mobile via CSS) ═══ -->
    <nav class="desktop-nav">
        <div class="dnav-inner">
            <a class="dnav-brand" asp-area="" asp-page="/Index">⚡ RepEngine</a>
            <div class="dnav-links">
                <a class="dnav-link" asp-area="" asp-page="/Index">Home</a>
                <a class="dnav-link" asp-area="" asp-page="/Dashboard">Dashboard</a>
                <a class="dnav-link" asp-area="" asp-page="/Governance">Governance</a>
                <a class="dnav-link" asp-area="" asp-page="/Jobs">Jobs</a>
                <button id="walletConnectBtnDesktop" class="dnav-wallet">
                    <span id="walletBtnTextDesktop">Connect Wallet</span>
                </button>
            </div>
        </div>
    </nav>

    <!-- ═══ MOBILE TOP BAR (hidden on desktop via CSS) ═══ -->
    <header class="topbar">
        <div class="topbar-inner">
            <span class="topbar-brand">⚡ RepEngine</span>
            <button id="walletConnectBtn" class="topbar-wallet">
                <span id="walletBtnText">Connect</span>
            </button>
        </div>
    </header>

    <!-- ═══ PAGE CONTENT ═══ -->
    <main class="page-content">
        @RenderBody()
    </main>

    <!-- ═══ FOOTER ═══ -->
    <footer class="footer">
        <div class="container">
            <p>&copy; 2026 RepEngine &mdash; Powered by <a href="https://fairscale.xyz" target="_blank">FairScale</a></p>
        </div>
    </footer>

    <!-- ═══ MOBILE BOTTOM NAV (hidden on desktop via CSS) ═══ -->
    <nav class="bottom-nav" id="bottomNav">
        <a class="bnav-item" href="/" data-page="Home">
            <svg class="bnav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
            <span class="bnav-label">Home</span>
        </a>
        <a class="bnav-item" href="/Dashboard" data-page="Dashboard">
            <svg class="bnav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <rect x="3" y="3" width="7" height="7" rx="1"/>
                <rect x="14" y="3" width="7" height="7" rx="1"/>
                <rect x="3" y="14" width="7" height="7" rx="1"/>
                <rect x="14" y="14" width="7" height="7" rx="1"/>
            </svg>
            <span class="bnav-label">Dashboard</span>
        </a>
        <a class="bnav-item" href="/Governance" data-page="Governance">
            <svg class="bnav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                <path d="M2 17l10 5 10-5"/>
                <path d="M2 12l10 5 10-5"/>
            </svg>
            <span class="bnav-label">Govern</span>
        </a>
        <a class="bnav-item" href="/Jobs" data-page="Jobs">
            <svg class="bnav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <rect x="2" y="7" width="20" height="14" rx="2"/>
                <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
            </svg>
            <span class="bnav-label">Jobs</span>
        </a>
    </nav>

    <script src="~/js/pwa.js" asp-append-version="true"></script>
    <script src="~/js/wallet.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
