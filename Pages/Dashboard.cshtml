@page
@model RepEngine.Pages.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}

<section class="section">
    <div class="container">
        <h1 class="mb-2">Dashboard</h1>
        <p class="text-muted mb-4">Your on-chain reputation at a glance</p>

        <!-- Connect Prompt -->
        <div id="connectPrompt" class="card text-center" style="padding:2.5rem 1rem;">
            <h2 class="mb-2">Connect Your Wallet</h2>
            <p class="text-muted mb-4">Connect your wallet to view your reputation dashboard</p>
            <button class="btn btn-primary" onclick="promptWalletConnection()">Connect Wallet</button>
        </div>

        <!-- Dashboard Content (hidden until wallet connected) -->
        <div id="dashboardContent" style="display:none;">

            <!-- Score Overview -->
            <div class="card mb-4">
                <div class="flex flex-col items-center gap-4">
                    <div class="score-gauge" id="dashGauge">
                        <div class="score-gauge-inner">
                            <div class="score-value" id="dashScore">--</div>
                            <div class="text-xs text-muted">FairScore</div>
                        </div>
                    </div>
                    <div id="dashTier" class="tier-badge tier-unranked">⚪ Unranked</div>
                </div>
            </div>

            <!-- Stats Grid -->
            <div class="grid grid-cols-2 md-grid-cols-4 gap-3 mb-4">
                <div class="stat-card">
                    <div class="stat-value" id="dashVotingPower">--</div>
                    <div class="stat-label">Voting Power</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value" id="dashTxCount">--</div>
                    <div class="stat-label">Transactions</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value" id="dashActiveDays">--</div>
                    <div class="stat-label">Active Days</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value" id="dashWalletAge">--</div>
                    <div class="stat-label">Wallet Age (d)</div>
                </div>
            </div>

            <!-- Sub-scores -->
            <div class="grid grid-cols-1 md-grid-cols-2 gap-3 mb-4">
                <div class="card">
                    <h3 class="mb-3">📊 Score Breakdown</h3>
                    <div class="mb-3">
                        <div class="flex justify-between text-sm mb-1">
                            <span>Wallet Score</span>
                            <strong id="dashBaseScore">--</strong>
                        </div>
                        <div class="progress"><div class="progress-fill" id="dashBaseBar" style="width:0%"></div></div>
                    </div>
                    <div>
                        <div class="flex justify-between text-sm mb-1">
                            <span>Social Score</span>
                            <strong id="dashSocialScore">--</strong>
                        </div>
                        <div class="progress"><div class="progress-fill" id="dashSocialBar" style="width:0%;background:var(--grad-gold)"></div></div>
                    </div>
                </div>

                <div class="card">
                    <h3 class="mb-3">🏅 Badges</h3>
                    <div id="dashBadges" class="flex flex-wrap gap-2">
                        <span class="text-muted text-sm">No badges yet</span>
                    </div>
                </div>
            </div>

            <!-- Percentile Breakdown -->
            <div class="card mb-4">
                <h3 class="mb-3">🔬 On-Chain Metrics</h3>
                <div class="grid grid-cols-2 md-grid-cols-4 gap-3" id="dashMetrics"></div>
            </div>

            <!-- Improvement Tips -->
            <div class="card">
                <h3 class="mb-3">💡 How to Improve</h3>
                <div id="dashSuggestions"></div>
            </div>
        </div>
    </div>
</section>

<script>
window.addEventListener('walletConnected', e => loadDashboard(e.detail.wallet));
document.addEventListener('DOMContentLoaded', () => {
    const w = window.walletManager?.getCurrentWallet?.();
    if (w) loadDashboard(w);
});

async function loadDashboard(wallet) {
    document.getElementById('connectPrompt').style.display = 'none';
    document.getElementById('dashboardContent').style.display = 'block';

    try {
        const res = await fetch(`/api/fairscore?wallet=${encodeURIComponent(wallet)}`);
        const d = await res.json();
        const score = d.score ?? Math.min(100, Math.round(d.fairscore ?? 0));
        const tierName = d.tier?.name ?? d.tier ?? 'Unranked';

        // Gauge
        document.getElementById('dashScore').textContent = score;
        document.getElementById('dashGauge').style.setProperty('--score-angle', `${(score/100)*360}deg`);

        // Tier
        const tierEl = document.getElementById('dashTier');
        const icons = { unranked:'⚪', bronze:'🥉', silver:'🥈', gold:'🥇', platinum:'💎', diamond:'💠' };
        tierEl.className = `tier-badge tier-${tierName.toLowerCase()}`;
        tierEl.textContent = `${icons[tierName.toLowerCase()]||'⚪'} ${tierName.charAt(0).toUpperCase()+tierName.slice(1)}`;

        // Voting power
        const vp = { unranked:.5, bronze:1, silver:1.5, gold:2, platinum:3, diamond:5 };
        document.getElementById('dashVotingPower').textContent = `${vp[tierName.toLowerCase()]||1}×`;

        // Stats
        const f = d.features ?? {};
        document.getElementById('dashTxCount').textContent = (f.txCount??0).toLocaleString();
        document.getElementById('dashActiveDays').textContent = f.activeDays ?? 0;
        document.getElementById('dashWalletAge').textContent = f.walletAgeDays ?? 0;

        // Sub-scores
        const base = d.fairscoreBase ?? 0;
        const social = d.socialScore ?? 0;
        document.getElementById('dashBaseScore').textContent = base.toFixed(1);
        document.getElementById('dashSocialScore').textContent = social.toFixed(1);
        document.getElementById('dashBaseBar').style.width = `${Math.min(100, base)}%`;
        document.getElementById('dashSocialBar').style.width = `${Math.min(100, social)}%`;

        // Badges
        const badges = d.badges ?? [];
        const badgeEl = document.getElementById('dashBadges');
        badgeEl.innerHTML = badges.length
            ? badges.map(b => `<span class="badge badge-primary">🏅 ${b.label}</span>`).join('')
            : '<span class="text-muted text-sm">No badges yet</span>';

        // Metrics
        const metrics = [
            { label: 'LST Percentile', value: ((f.lstPercentileScore??0)*100).toFixed(0)+'%' },
            { label: 'Major Holdings',  value: ((f.majorPercentileScore??0)*100).toFixed(0)+'%' },
            { label: 'Native SOL',      value: ((f.nativeSolPercentile??0)*100).toFixed(0)+'%' },
            { label: 'Stablecoin',      value: ((f.stablePercentileScore??0)*100).toFixed(0)+'%' },
        ];
        document.getElementById('dashMetrics').innerHTML = metrics.map(m =>
            `<div class="stat-card"><div class="stat-value">${m.value}</div><div class="stat-label">${m.label}</div></div>`
        ).join('');

        // Suggestions
        const sugRes = await fetch(`/api/dashboard?wallet=${encodeURIComponent(wallet)}`);
        const sugData = await sugRes.json();
        const tips = sugData.suggestions ?? [];
        document.getElementById('dashSuggestions').innerHTML = tips.length
            ? tips.map(s => `<p class="text-sm mb-2">${s}</p>`).join('')
            : '<p class="text-sm text-muted">You\'re doing great!</p>';
    } catch (e) {
        console.error('Dashboard load error:', e);
    }
}
</script>
