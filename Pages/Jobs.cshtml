@page
@model RepEngine.Pages.JobsModel
@{
    ViewData["Title"] = "Jobs";
}

<section class="section">
    <div class="container">
        <div class="flex justify-between items-center mb-4 flex-wrap gap-3">
            <div>
                <h1 class="mb-1">Job Board</h1>
                <p class="text-muted text-sm">Reputation-gated freelance opportunities</p>
            </div>
        </div>

        <!-- Connect prompt -->
        <div id="jobsConnectPrompt" class="card text-center" style="padding:2.5rem 1rem;">
            <h2 class="mb-2">Connect Your Wallet</h2>
            <p class="text-muted mb-4">Connect to see jobs matching your reputation tier</p>
            <button class="btn btn-primary" onclick="promptWalletConnection()">Connect Wallet</button>
        </div>

        <!-- Jobs list -->
        <div id="jobsList" style="display:none;"></div>
    </div>
</section>

<!-- Apply Modal -->
<div id="applyModal" class="modal-overlay" style="display:none;" onclick="if(event.target===this)closeApply()">
    <div class="modal-content">
        <h2 class="mb-4">Apply for Job</h2>
        <h3 id="applyJobTitle" class="mb-3"></h3>
        <input type="hidden" id="applyJobId" />
        <div class="form-group">
            <label class="form-label">Cover Letter</label>
            <textarea id="applyCover" rows="4" placeholder="Why are you a good fit?"></textarea>
        </div>
        <div class="form-group">
            <label class="form-label">Proposed Rate ($)</label>
            <input type="number" id="applyRate" placeholder="e.g. 500" />
        </div>
        <div class="flex gap-3">
            <button class="btn btn-primary btn-block" onclick="submitApplication()">Apply</button>
            <button class="btn btn-secondary" onclick="closeApply()">Cancel</button>
        </div>
    </div>
</div>

<script>
window.addEventListener('walletConnected', e => loadJobs(e.detail.wallet));
document.addEventListener('DOMContentLoaded', () => {
    const w = window.walletManager?.getCurrentWallet?.();
    if (w) loadJobs(w);
});

async function loadJobs(wallet) {
    document.getElementById('jobsConnectPrompt').style.display = 'none';
    const list = document.getElementById('jobsList');
    list.style.display = 'block';
    list.innerHTML = '<div class="text-center mt-4"><div class="spinner" style="margin:0 auto"></div><p class="loading-text mt-2">Loading jobs…</p></div>';

    try {
        const res = await fetch(`/api/jobs?wallet=${encodeURIComponent(wallet)}`);
        const data = await res.json();
        const jobs = data.jobs ?? data;
        renderJobs(jobs);
    } catch (e) {
        list.innerHTML = '<p class="text-muted text-center">Failed to load jobs</p>';
    }
}

function renderJobs(jobs) {
    const list = document.getElementById('jobsList');
    if (!jobs.length) {
        list.innerHTML = '<div class="card text-center"><p class="text-muted">No jobs available for your tier</p></div>';
        return;
    }
    list.innerHTML = jobs.map(j => `
        <div class="card card-interactive mb-3${j.isPremium ? ' premium-glow' : ''}">
            <div class="flex justify-between items-center mb-2 flex-wrap gap-2">
                <h3 style="margin:0">${j.title}</h3>
                ${j.isPremium ? '<span class="badge badge-warning">⭐ PREMIUM</span>' : ''}
            </div>
            <p class="text-sm text-muted mb-3">${j.description}</p>
            <div class="flex gap-2 flex-wrap mb-3">
                ${(j.skills??[]).map(s => `<span class="skill-tag">${s}</span>`).join('')}
            </div>
            <div class="flex justify-between items-center flex-wrap gap-2">
                <div>
                    <span class="font-bold text-accent text-lg">$${(j.budget??0).toLocaleString()}</span>
                    <span class="text-xs text-muted ml-2">Min: ${j.requiredTier ?? 'Any'}</span>
                </div>
                <button class="btn btn-primary btn-sm" onclick="openApply(${j.id}, '${j.title.replace(/'/g,"\\'")}')">Apply</button>
            </div>
        </div>
    `).join('');
}

function openApply(id, title) {
    document.getElementById('applyJobId').value = id;
    document.getElementById('applyJobTitle').textContent = title;
    document.getElementById('applyModal').style.display = 'flex';
}
function closeApply() { document.getElementById('applyModal').style.display = 'none'; }

async function submitApplication() {
    const wallet = window.walletManager?.getCurrentWallet?.();
    if (!wallet) { alert('Connect your wallet first'); return; }
    const jobId = parseInt(document.getElementById('applyJobId').value);
    const cover = document.getElementById('applyCover').value.trim();
    const rate  = parseFloat(document.getElementById('applyRate').value);
    if (!cover || !rate) { alert('Fill in all fields'); return; }

    try {
        const res = await fetch('/api/jobs/apply', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ jobId, walletAddress: wallet, coverLetter: cover, proposedRate: rate })
        });
        if (res.ok) { closeApply(); alert('Application submitted!'); }
        else {
            const err = await res.json().catch(() => ({}));
            alert(err.error || 'Application failed');
        }
    } catch (e) { alert('Failed: ' + e.message); }
}
</script>

<style>
.premium-glow { border-color: rgba(245,158,11,.3); box-shadow: 0 0 20px rgba(245,158,11,.08); }
</style>
