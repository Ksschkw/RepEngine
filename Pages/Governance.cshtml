@page
@model RepEngine.Pages.GovernanceModel
@{
    ViewData["Title"] = "Governance";
}

<section class="section">
    <div class="container">
        <div class="flex justify-between items-center mb-4 flex-wrap gap-3">
            <div>
                <h1 class="mb-1">Governance</h1>
                <p class="text-muted text-sm">Vote on proposals with reputation-weighted power</p>
            </div>
            <button id="createProposalBtn" class="btn btn-primary" onclick="openCreateModal()">
                + New Proposal
            </button>
        </div>

        <!-- Proposals List -->
        <div id="proposalsList">
            <div class="text-center mt-6">
                <div class="spinner" style="margin:0 auto;"></div>
                <p class="loading-text mt-2">Loading proposals…</p>
            </div>
        </div>
    </div>
</section>

<!-- Create Proposal Modal -->
<div id="newProposalModal" class="modal-overlay" style="display:none;" onclick="if(event.target===this)closeCreateModal()">
    <div class="modal-content">
        <h2 class="mb-4">Create Proposal</h2>
        <div class="form-group">
            <label class="form-label">Title</label>
            <input type="text" id="proposalTitle" placeholder="Proposal title" />
        </div>
        <div class="form-group">
            <label class="form-label">Category</label>
            <select id="proposalCategory">
                <option value="Platform Economics">Platform Economics</option>
                <option value="Reputation System">Reputation System</option>
                <option value="Platform Features">Platform Features</option>
                <option value="Community">Community</option>
            </select>
        </div>
        <div class="form-group">
            <label class="form-label">Description</label>
            <textarea id="proposalDesc" rows="4" placeholder="Describe your proposal…"></textarea>
        </div>
        <div class="flex gap-3">
            <button class="btn btn-primary btn-block" onclick="submitProposal()">Submit</button>
            <button class="btn btn-secondary" onclick="closeCreateModal()">Cancel</button>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', loadProposals);

async function loadProposals() {
    try {
        const res = await fetch('/api/governance/proposals/active');
        const proposals = await res.json();
        renderProposals(proposals);
    } catch (e) {
        document.getElementById('proposalsList').innerHTML =
            '<p class="text-muted text-center">Failed to load proposals</p>';
    }
}

function renderProposals(proposals) {
    if (!proposals.length) {
        document.getElementById('proposalsList').innerHTML =
            '<div class="card text-center"><p class="text-muted">No active proposals</p></div>';
        return;
    }
    document.getElementById('proposalsList').innerHTML = proposals.map(p => {
        const total = p.votesFor + p.votesAgainst || 1;
        const forPct = ((p.votesFor / total) * 100).toFixed(0);
        const statusClass = p.status.toLowerCase();
        return `
        <div class="card card-interactive mb-3">
            <div class="flex justify-between items-center mb-2 flex-wrap gap-2">
                <h3 style="margin:0">${p.title}</h3>
                <span class="badge badge-${statusClass === 'active' ? 'success' : statusClass === 'passed' ? 'info' : 'danger'}">${p.status}</span>
            </div>
            <p class="text-sm text-muted mb-3">${p.description}</p>
            <div class="flex gap-2 flex-wrap text-xs text-muted mb-3">
                <span>📂 ${p.category}</span>
                <span>👥 ${p.totalVoters} voters</span>
                <span>⚡ ${p.totalVotingPower.toLocaleString()} power</span>
            </div>

            <div class="mb-2">
                <div class="flex justify-between text-xs mb-1">
                    <span class="text-success">For ${forPct}%</span>
                    <span class="text-muted">${p.votesFor} / ${p.votesAgainst}</span>
                </div>
                <div class="vote-bar">
                    <div class="vote-bar-fill" style="width:${forPct}%"></div>
                </div>
            </div>

            <div class="flex gap-2 mt-3">
                <button class="btn btn-success btn-sm" onclick="vote(${p.id},'For')">👍 Vote For</button>
                <button class="btn btn-danger btn-sm" onclick="vote(${p.id},'Against')">👎 Against</button>
            </div>
        </div>`;
    }).join('');
}

async function vote(proposalId, voteType) {
    const wallet = window.walletManager?.getCurrentWallet?.();
    if (!wallet) { alert('Connect your wallet first'); return; }
    try {
        const res = await fetch('/api/governance/vote', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ proposalId, walletAddress: wallet, vote: voteType })
        });
        if (res.ok) { loadProposals(); }
        else {
            const err = await res.json().catch(() => ({}));
            alert(err.error || 'Vote failed');
        }
    } catch (e) { alert('Vote failed: ' + e.message); }
}

function openCreateModal()  { document.getElementById('newProposalModal').style.display = 'flex'; }
function closeCreateModal() { document.getElementById('newProposalModal').style.display = 'none'; }

async function submitProposal() {
    const wallet = window.walletManager?.getCurrentWallet?.();
    if (!wallet) { alert('Connect your wallet first'); return; }
    const title = document.getElementById('proposalTitle').value.trim();
    const desc  = document.getElementById('proposalDesc').value.trim();
    const cat   = document.getElementById('proposalCategory').value;
    if (!title || !desc) { alert('Fill in all fields'); return; }

    try {
        const res = await fetch('/api/governance/proposals', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ title, description: desc, category: cat, creatorWallet: wallet })
        });
        if (res.ok) { closeCreateModal(); loadProposals(); }
    } catch (e) { alert('Failed: ' + e.message); }
}
</script>
