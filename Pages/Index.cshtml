@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<!-- Hero -->
<section class="section-lg">
    <div class="container text-center fade-in">
        <h1 style="margin-bottom: .75rem;">
            Reputation is the<br/>New Currency
        </h1>
        <p class="text-lg" style="max-width: 600px; margin: 0 auto 1.5rem;">
            Unlock opportunities through on-chain reputation. Vote with weighted power. Access exclusive jobs.
        </p>
        <div class="flex justify-center gap-3 flex-wrap">
            <button class="btn btn-primary btn-lg" onclick="scrollToDemo()">Try Live Demo</button>
            <a href="/Dashboard" class="btn btn-secondary btn-lg">View Dashboard</a>
        </div>
    </div>
</section>

<!-- Live Demo -->
<section id="demo" class="section">
    <div class="container">
        <div class="card" style="max-width: 560px; margin: 0 auto;">
            <h2 class="text-center mb-4">Check Your FairScore</h2>
            <!-- Real Wallet Authentication -->
            <div id="walletConnectSection" class="flex flex-col gap-3">
                <button class="btn btn-primary btn-block" onclick="window.walletManager.promptWalletConnection()">
                    Connect Wallet
                </button>
            </div>
            
            <div id="connectedWalletSection" style="display: none;" class="mt-3">
                <p class="text-sm text-muted text-center mb-3">
                    Connected: <strong id="connectedAddress" class="text-accent font-mono"></strong>
                </p>
                <button class="btn btn-primary btn-block" onclick="checkScore()">
                    <span id="checkScoreText">Load Reputation Score</span>
                </button>
            </div>

            <!-- Result -->
            <div id="scoreResult" style="display:none;" class="mt-6">
                <div class="flex flex-col items-center gap-4">
                    <!-- Gauge -->
                    <div class="score-gauge" id="scoreGauge">
                        <div class="score-gauge-inner">
                            <div class="score-value" id="scoreValue">--</div>
                            <div class="text-xs text-muted">FairScore</div>
                        </div>
                    </div>

                    <!-- Tier -->
                    <div id="tierBadge" class="tier-badge tier-unranked">⚪ Unranked</div>

                    <!-- Sub-scores -->
                    <div class="grid grid-cols-2 gap-3 w-full" style="max-width:360px;">
                        <div class="stat-card">
                            <div class="stat-value" id="walletBaseScore">--</div>
                            <div class="stat-label">Wallet Score</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-value" id="socialScore" style="color:var(--accent-secondary)">--</div>
                            <div class="stat-label">Social Score</div>
                        </div>
                    </div>

                    <!-- Badges -->
                    <div id="badgesSection" style="display:none; width:100%; max-width:480px;">
                        <h4 class="mb-2">🏅 Earned Badges</h4>
                        <div id="badgesList" class="flex flex-wrap gap-2"></div>
                    </div>

                    <!-- Activity -->
                    <div style="width:100%; max-width:480px;" class="mt-2">
                        <h4 class="mb-3">📊 Wallet Activity</h4>
                        <div class="card" style="padding:.85rem 1rem;">
                            <div class="flex justify-between items-center mb-3">
                                <span class="text-sm">🔢 Transactions</span>
                                <strong class="text-accent" id="txCountDisplay">--</strong>
                            </div>
                            <div class="flex justify-between items-center mb-3">
                                <span class="text-sm">📅 Wallet Age</span>
                                <strong class="text-accent" id="walletAgeDisplay">--</strong>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-sm">⚡ Active Days</span>
                                <strong class="text-accent" id="activeDaysDisplay">--</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Tiers -->
<section class="section">
    <div class="container">
        <h2 class="text-center mb-2">Reputation Tiers</h2>
        <p class="text-center text-muted mb-4">Higher reputation unlocks more power and opportunities</p>

        <div class="grid grid-cols-2 md-grid-cols-3 gap-3">
            <div class="card text-center">
                <div class="tier-badge tier-bronze mb-3" style="font-size:.8rem">🥉 Bronze</div>
                <p class="text-xs text-muted mb-2">Score: 20–39</p>
                <p class="text-xs">1× voting · Entry jobs · 5% discount</p>
            </div>
            <div class="card text-center">
                <div class="tier-badge tier-silver mb-3" style="font-size:.8rem">🥈 Silver</div>
                <p class="text-xs text-muted mb-2">Score: 40–59</p>
                <p class="text-xs">1.5× voting · Proposals · 10% discount</p>
            </div>
            <div class="card text-center">
                <div class="tier-badge tier-gold mb-3" style="font-size:.8rem">🥇 Gold</div>
                <p class="text-xs text-muted mb-2">Score: 60–79</p>
                <p class="text-xs">2× voting · Premium jobs · 15% discount</p>
            </div>
            <div class="card text-center">
                <div class="tier-badge tier-platinum mb-3" style="font-size:.8rem">💎 Platinum</div>
                <p class="text-xs text-muted mb-2">Score: 80–94</p>
                <p class="text-xs">3× voting · Exclusive access · 20% discount</p>
            </div>
            <div class="card text-center">
                <div class="tier-badge tier-diamond mb-3" style="font-size:.8rem">💠 Diamond</div>
                <p class="text-xs text-muted mb-2">Score: 95–100</p>
                <p class="text-xs">5× voting · VIP jobs · Revenue share</p>
            </div>
            <div class="card text-center">
                <div class="tier-badge tier-unranked mb-3" style="font-size:.8rem">⚪ Unranked</div>
                <p class="text-xs text-muted mb-2">Score: 0–19</p>
                <p class="text-xs">0.5× voting · View only</p>
            </div>
        </div>
    </div>
</section>

<!-- Features -->
<section class="section">
    <div class="container">
        <h2 class="text-center mb-4">Why RepEngine?</h2>
        <div class="grid grid-cols-1 md-grid-cols-2 gap-3">
            <div class="card">
                <h3>🗳️ Weighted DAO Governance</h3>
                <p class="text-sm mt-2">Your reputation determines voting power. Higher FairScore = more influence on platform decisions.</p>
            </div>
            <div class="card">
                <h3>💼 Reputation-Gated Jobs</h3>
                <p class="text-sm mt-2">Access premium freelance opportunities based on your on-chain reputation. Prove your worth.</p>
            </div>
            <div class="card">
                <h3>💎 Tier-Based Benefits</h3>
                <p class="text-sm mt-2">Climb the reputation ladder to unlock lower fees, exclusive features, and revenue sharing.</p>
            </div>
            <div class="card">
                <h3>🔒 Privacy-First Scoring</h3>
                <p class="text-sm mt-2">Powered by FairScale's privacy-preserving reputation infrastructure. Your data, your control.</p>
            </div>
        </div>
    </div>
</section>

<script>
function scrollToDemo() {
    document.getElementById('demo').scrollIntoView({ behavior: 'smooth' });
}

window.addEventListener('walletConnected', (e) => {
    document.getElementById('walletConnectSection').style.display = 'none';
    document.getElementById('connectedWalletSection').style.display = 'block';
    const address = e.detail.wallet;
    document.getElementById('connectedAddress').textContent = address.slice(0, 6) + '...' + address.slice(-4);
});

window.addEventListener('walletDisconnected', () => {
    document.getElementById('walletConnectSection').style.display = 'flex';
    document.getElementById('connectedWalletSection').style.display = 'none';
    document.getElementById('scoreResult').style.display = 'none';
});

document.addEventListener('DOMContentLoaded', () => {
    const w = window.walletManager?.getCurrentWallet?.();
    if (w) {
        window.dispatchEvent(new CustomEvent('walletConnected', { detail: { wallet: w } }));
    }
});

async function checkScore() {
    const btn = document.getElementById('checkScoreText');
    let wallet = window.walletManager?.getCurrentWallet();
    
    if (!wallet) {
        alert("Please connect a wallet first.");
        return;
    }

    btn.textContent = 'Authenticating…';
    try {
        const res  = await fetch(`/api/fairscore?wallet=${encodeURIComponent(wallet)}`);
        if (!res.ok) throw new Error('Failed to fetch reputation score');
        
        const data = await res.json();
        displayScore(data);
        document.getElementById('scoreResult').style.display = 'block';
    } catch (e) {
        alert('Error: ' + e.message);
    } finally {
        btn.textContent = 'Load Reputation Score';
    }
}

function displayScore(d) {
    const score = d.score ?? Math.min(100, Math.round(d.fairscore ?? 0));
    document.getElementById('scoreValue').textContent = score;
    document.getElementById('scoreGauge').style.setProperty('--score-angle', `${(score/100)*360}deg`);

    const tierName = (d.tier?.name ?? d.tier ?? 'Unranked');
    const badge = document.getElementById('tierBadge');
    badge.className = `tier-badge tier-${tierName.toLowerCase()}`;
    badge.textContent = `${getTierIcon(tierName)} ${tierName.charAt(0).toUpperCase()+tierName.slice(1)}`;

    document.getElementById('walletBaseScore').textContent = (d.fairscoreBase ?? 0).toFixed(1);
    document.getElementById('socialScore').textContent = (d.socialScore ?? 0).toFixed(1);

    const badges = d.badges ?? [];
    const sec = document.getElementById('badgesSection');
    if (badges.length) {
        sec.style.display = 'block';
        document.getElementById('badgesList').innerHTML = badges.map(b =>
            `<span class="badge badge-primary">🏅 ${b.label}</span>`
        ).join('');
    } else { sec.style.display = 'none'; }

    const f = d.features ?? {};
    document.getElementById('txCountDisplay').textContent = (f.txCount ?? 0).toLocaleString();
    document.getElementById('walletAgeDisplay').textContent = `${f.walletAgeDays ?? 0} days`;
    document.getElementById('activeDaysDisplay').textContent = `${f.activeDays ?? 0} days`;
}

function getTierIcon(t) {
    return { unranked:'⚪', bronze:'🥉', silver:'🥈', gold:'🥇', platinum:'💎', diamond:'💠' }[t.toLowerCase()] || '⚪';
}


</script>
